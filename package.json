{
  "name": "ai-coding-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "groq-sdk": "^1.5.0"
  }
}
